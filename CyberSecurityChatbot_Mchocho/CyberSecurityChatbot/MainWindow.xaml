<Window x:Class="CyberSecurityChatbot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CyberSecurityChatbot"
        mc:Ignorable="d"
        Title="CyberSentry - Cybersecurity Awareness Chatbot" 
        Height="700" 
        Width="1050"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextPrimary}">

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Left Sidebar (320px) -->
            <ColumnDefinition Width="320" />
            <!-- Main Chat Area (Star) -->
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- LEFT SIDEBAR -->
        <Border Grid.Column="0" 
                Background="{StaticResource CardBrush}" 
                BorderBrush="{StaticResource BorderBrush}" 
                BorderThickness="0,0,1.5,0">
            
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /> <!-- Header Info -->
                    <RowDefinition Height="Auto" /> <!-- ASCII Shield Art -->
                    <RowDefinition Height="*" />    <!-- Memory Status Card -->
                    <RowDefinition Height="Auto" /> <!-- Actions / Audio Button -->
                </Grid.RowDefinitions>

                <!-- Sidebar Header -->
                <StackPanel Grid.Row="0" Margin="0,0,0,20">
                    <TextBlock Text="🛡️ CYBERSENTRY" 
                               FontSize="22" 
                               FontWeight="Bold" 
                               Foreground="{StaticResource AccentCyan}" 
                               FontFamily="{StaticResource PrimaryFont}" />
                    <TextBlock Text="AI Security Assistant (Part 2)" 
                               FontSize="12" 
                               Foreground="{StaticResource TextSecondary}" 
                               FontFamily="{StaticResource PrimaryFont}" 
                               Margin="0,4,0,0" />
                </StackPanel>

                <!-- ASCII Art Box -->
                <Border Grid.Row="1" 
                        Background="{StaticResource BgBrush}" 
                        BorderBrush="{StaticResource BorderBrush}" 
                        BorderThickness="1" 
                        CornerRadius="8" 
                        Padding="10" 
                        Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="[System Security Shield]" 
                                   Foreground="{StaticResource TextSecondary}" 
                                   FontSize="10" 
                                   HorizontalAlignment="Center" 
                                   Margin="0,0,0,8" />
                        <TextBlock x:Name="TxtAsciiArt"
                                   FontFamily="{StaticResource MonospaceFont}" 
                                   FontSize="9.5" 
                                   Foreground="{StaticResource AccentCyan}" 
                                   HorizontalAlignment="Center"
                                   LineHeight="12" />
                    </StackPanel>
                </Border>

                <!-- Conversational Memory Panel -->
                <Border Grid.Row="2" 
                        Background="{StaticResource PanelBrush}" 
                        BorderBrush="{StaticResource BorderBrush}" 
                        BorderThickness="1" 
                        CornerRadius="8" 
                        Padding="15" 
                        VerticalAlignment="Top">
                    
                    <StackPanel>
                        <TextBlock Text="🔑 CONVERSATIONAL MEMORY" 
                                   FontSize="12" 
                                   FontWeight="SemiBold" 
                                   Foreground="{StaticResource AccentGreen}" 
                                   Margin="0,0,0,12" />

                        <!-- User Profile Fields -->
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="User Name:" FontSize="11" Foreground="{StaticResource TextSecondary}" />
                            <TextBlock x:Name="LblUserName" Text="Not Provided Yet" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,2,0,0" />
                        </StackPanel>

                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="Interests / Topic:" FontSize="11" Foreground="{StaticResource TextSecondary}" />
                            <TextBlock x:Name="LblInterest" Text="Not Provided Yet" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,2,0,0" />
                        </StackPanel>

                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="Active Topic Context:" FontSize="11" Foreground="{StaticResource TextSecondary}" />
                            <Border Background="{StaticResource BgBrush}" CornerRadius="4" Padding="8,4" HorizontalAlignment="Left" Margin="0,4,0,0">
                                <TextBlock x:Name="LblLastTopic" Text="general" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentCyan}" />
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Audio Action -->
                <StackPanel Grid.Row="3" VerticalAlignment="Bottom">
                    <Border Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <TextBlock Text="Voice greeting initialized. Click below to replay the sound cue." 
                                   FontSize="11" 
                                   Foreground="{StaticResource TextSecondary}" 
                                   TextWrapping="Wrap" 
                                   HorizontalAlignment="Center" 
                                   TextAlignment="Center" />
                    </Border>
                    <Button Content="🔊 Replay Welcome Audio" 
                            Style="{StaticResource SecondaryCyberButton}" 
                            Click="BtnPlayAudio_Click" 
                            HorizontalAlignment="Stretch" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN CHAT AREA -->
        <Grid Grid.Column="1" Margin="25,20,25,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />    <!-- Chat History List -->
                <RowDefinition Height="Auto" /> <!-- Input Panel -->
            </Grid.RowDefinitions>

            <!-- Chat History -->
            <ListBox x:Name="LstChat" 
                     Grid.Row="0"
                     Background="Transparent" 
                     BorderThickness="0" 
                     Margin="0,0,0,15"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     HorizontalContentAlignment="Stretch">
                
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="Focusable" Value="False" />
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="{Binding BubbleMargin}">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="HorizontalAlignment" Value="Left" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsUser}" Value="True">
                                            <Setter Property="HorizontalAlignment" Value="Right" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Sender & Time Info -->
                            <StackPanel Orientation="Horizontal" Margin="8,2">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="HorizontalAlignment" Value="Left" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsUser}" Value="True">
                                                <Setter Property="HorizontalAlignment" Value="Right" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="{Binding Sender}" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" />
                                <TextBlock Text=" • " FontSize="10.5" Foreground="{StaticResource TextSecondary}" />
                                <TextBlock Text="{Binding Timestamp, StringFormat=t}" FontSize="10.5" Foreground="{StaticResource TextSecondary}" />
                            </StackPanel>

                            <!-- Chat Bubble -->
                            <Border Grid.Row="1"
                                    Background="{Binding BubbleBackground}"
                                    BorderBrush="{Binding BubbleBorder}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="16,12"
                                    Margin="0,2,0,8"
                                    MaxWidth="550">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="HorizontalAlignment" Value="Left" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsUser}" Value="True">
                                                <Setter Property="HorizontalAlignment" Value="Right" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding MessageText}" 
                                           Foreground="{StaticResource TextPrimary}" 
                                           FontSize="13.5" 
                                           TextWrapping="Wrap" 
                                           FontFamily="{StaticResource PrimaryFont}"
                                           LineHeight="19" />
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Bottom Input Panel -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox x:Name="TxtInput" 
                         Grid.Column="0" 
                         Style="{StaticResource CyberTextBox}" 
                         Tag="Type a security query, name, or sentiment... (e.g. 'I'm worried about scams')"
                         KeyDown="TxtInput_KeyDown" 
                         VerticalAlignment="Center" 
                         Margin="0,0,12,0"/>
                
                <Button x:Name="BtnSend" 
                        Grid.Column="1" 
                        Content="Send Message" 
                        Style="{StaticResource CyberButton}" 
                        Click="BtnSend_Click" 
                        Padding="24,12" 
                        VerticalAlignment="Center"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
